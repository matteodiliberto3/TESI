# =========================================================================
# MLOps Security Lab - Environment Configuration Template (.env.example)
# =========================================================================
# Copy this file to .env and configure real secrets for your environment.
# NEVER commit the actual .env file or production credentials to git.

# 1. Administrative Reload Secret Token
# Required ONLY for administrative model reloading via POST /reload.
# Ordinary inference (/health, /predict, /info) functions without this token.
# Must be set to a high-entropy secret string (min. 32 characters recommended).
MLOPS_ADMIN_TOKEN=replace_with_external_high_entropy_secret_token_here

# 2. Deserialization Security Policies
# FAIL-CLOSED DEFAULT: Both policies must remain "false" in secure environments.
ALLOW_INSECURE_RELOAD=false
ALLOW_UNSIGNED_MLFLOW=false

# 3. MLflow Tracking Server Connectivity
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# 4. Container UID/GID alignment for Least-Privilege Execution
CURRENT_UID=1000
CURRENT_GID=1000
